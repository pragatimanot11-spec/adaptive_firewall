{
  "static_rules": {
  "blacklisted_ips": ["10.66.66.66"],
  "restricted_ports": [23, 135, 139, 445, 3389, 31337, 4444, 6667],
  "allowed_protocols": ["TCP", "UDP", "ICMP"]
},
  "window_seconds": 10,
  "baseline": {
    "alpha": 0.1,
    "min_observations": 20,
    "sample_interval_seconds": 1.0,
    "max_update_score": 2.0,
    "relative_min_std": 0.1,
    "min_std": {
      "packet_rate": 2.0,
      "distinct_ports": 2.0,
      "byte_rate": 2000.0,
      "syn_count": 2.0
    }
  },
  "thresholds": {
    "z_medium": 3.0,
    "z_high": 5.0,
    "stat_min_values": {
      "packet_rate": 10.0,
      "distinct_ports": 8.0,
      "byte_rate": 20000.0,
      "syn_count": 8.0
    },
    "hard_limits": {
      "packet_rate": { "alert": 50.0, "block": 200.0 },
      "distinct_ports": { "alert": 15.0, "block": 40.0 },
      "byte_rate": { "alert": 200000.0, "block": 1000000.0 },
      "syn_count": { "alert": 20.0, "block": 60.0 }
    }
  },
  "response": {
    "block_on_high": true,
    "block_duration_seconds": 60
  },
  "housekeeping": {
    "host_idle_seconds": 3600,
    "cleanup_every_packets": 1000
  }
}
